---
/**
 * Static Astro rather than a React island: the footer has zero interactivity, so
 * hydrating it cost every page a third bundle for nothing.
 */
// lucide-react renders fine server-side in .astro with no client directive — plain HTML,
// no hydration, no extra dependency.
import { Mail, Phone, MapPin, ArrowRight } from 'lucide-react';
import type { Lang } from '../../i18n/types';
import { dict } from '../../i18n/dictionaries';
import { localizedHref } from '../../i18n/href';
import { COMPANIES } from '../../data/companies';
import { EMAIL, PHONES } from '../../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dict[lang];
const href = (path: string) => localizedHref(path, lang);
const year = new Date().getFullYear();

const linkClass = 'text-white/70 hover:text-primary-300 transition-colors';
const headingClass = 'text-xs font-bold uppercase tracking-[0.18em] text-white/60 mb-6';
---

<footer class="bg-ink text-white">
  {/* Red top accent */}
  <div class="h-1 bg-primary w-full"></div>

  <div class="container-page pt-16 pb-12 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
    {/* Brand */}
    <div>
      <a href={href('/')} class="inline-flex">
        <img
          src="/assets/logo/main-logo.svg"
          alt={t.brand.group}
          width={157}
          height={40}
          class="h-10 w-auto object-contain"
        />
      </a>
      <p class="mt-5 text-sm text-white/55 leading-relaxed max-w-xs">{t.footer.tagline}</p>
      <a
        href={href('/contact?subject=quote')}
        class="inline-flex items-center gap-2 mt-6 text-sm font-semibold text-primary-300 hover:text-primary-200 transition-colors"
      >
        {t.nav.getQuote}
        <ArrowRight className="h-4 w-4 rtl-flip" />
      </a>
    </div>

    {/* The three companies — the footer is the one place all of them are always listed. */}
    <div>
      <h3 class={headingClass}>{t.nav.ourCompanies}</h3>
      <ul class="space-y-3 text-sm">
        {
          COMPANIES.map((c) => (
            <li>
              <a href={href(c.base)} class={linkClass}>
                {t.companies[c.id].short}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {/* Explore */}
    <div>
      <h3 class={headingClass}>{t.footer.explore}</h3>
      <ul class="space-y-3 text-sm">
        <li><a href={href('/about')} class={linkClass}>{t.nav.about}</a></li>
        <li><a href={href('/services')} class={linkClass}>{t.nav.services}</a></li>
        <li><a href={href('/team')} class={linkClass}>{t.nav.team}</a></li>
        <li><a href={href('/gallery')} class={linkClass}>{t.nav.gallery}</a></li>
        <li><a href={href('/contact')} class={linkClass}>{t.nav.contact}</a></li>
      </ul>
    </div>

    {/* Contact */}
    <div>
      <h3 class={headingClass}>{t.footer.contact}</h3>
      <ul class="space-y-4 text-sm">
        <li class="flex items-start gap-3">
          <MapPin className="h-4 w-4 mt-0.5 text-primary flex-shrink-0" />
          <span class="text-white/70">{t.contact.info.address}</span>
        </li>
        <li>
          <a href={`mailto:${EMAIL}`} class={`flex items-start gap-3 ${linkClass}`}>
            <Mail className="h-4 w-4 mt-0.5 text-primary flex-shrink-0" />
            <span class="break-all">{EMAIL}</span>
          </a>
        </li>
        <li>
          <a href={`tel:${PHONES[0]}`} class={`flex items-start gap-3 ${linkClass}`}>
            <Phone className="h-4 w-4 mt-0.5 text-primary flex-shrink-0" />
            <span dir="ltr">{t.contact.info.phone}</span>
          </a>
        </li>
        <li>
          <a href={`tel:${PHONES[1]}`} class={`flex items-start gap-3 ${linkClass}`}>
            <Phone className="h-4 w-4 mt-0.5 text-primary flex-shrink-0" />
            <span dir="ltr">{t.contact.info.phone2}</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div
      class="container-page py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/60"
    >
      <p>© {year} {t.brand.group}. {t.footer.rights}</p>
      <p class="text-white/55">{t.brand.tagline}</p>
    </div>
  </div>
</footer>
