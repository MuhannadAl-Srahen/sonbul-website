---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CompanySection from '../../../components/pages/CompanySection';
import { dict } from '../../../i18n/dictionaries';
import { localePaths, langOf } from '../../../i18n/paths';

export const getStaticPaths = localePaths;

const lang = langOf(Astro.params.lang as string | undefined);
const seo = dict[lang].projectServices.sections.camps.seo;
---

<BaseLayout title={seo.title} description={seo.description} path={Astro.url.pathname} lang={lang}>
  <CompanySection company="project-services" section="camps" lang={lang} />
</BaseLayout>
