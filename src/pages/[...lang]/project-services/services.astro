---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CompanyServices from '../../../components/pages/CompanyServices';
import { dict } from '../../../i18n/dictionaries';
import { localePaths, langOf } from '../../../i18n/paths';

export const getStaticPaths = localePaths;

const lang = langOf(Astro.params.lang as string | undefined);
const t = dict[lang];
---

<BaseLayout
  title={t.projectServices.services.title}
  description={t.projectServices.services.subtitle}
  path={Astro.url.pathname}
  lang={lang}
>
  <CompanyServices company="project-services" lang={lang} />
</BaseLayout>
