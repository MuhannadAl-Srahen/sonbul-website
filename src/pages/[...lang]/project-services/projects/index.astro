---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CompanyCollection from '../../../../components/pages/CompanyCollection';
import { dict } from '../../../../i18n/dictionaries';
import { localePaths, langOf } from '../../../../i18n/paths';

export const getStaticPaths = localePaths;

const lang = langOf(Astro.params.lang as string | undefined);
const t = dict[lang];
---

<BaseLayout
  title={t.projectServices.projects.title}
  description={t.projectServices.projects.subtitle}
  path={Astro.url.pathname}
  lang={lang}
>
  <CompanyCollection collection="projects" lang={lang} client:load />
</BaseLayout>
