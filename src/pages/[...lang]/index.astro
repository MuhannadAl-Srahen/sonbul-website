---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GroupHome from '../../components/pages/GroupHome';
import { dict } from '../../i18n/dictionaries';
import { localePaths, langOf } from '../../i18n/paths';

export const getStaticPaths = localePaths;

const lang = langOf(Astro.params.lang as string | undefined);
const t = dict[lang];
---

<BaseLayout
  title={t.group.seo.home.title}
  description={t.group.seo.home.description}
  path={Astro.url.pathname}
  lang={lang}
>
  <GroupHome lang={lang} client:load />
</BaseLayout>
