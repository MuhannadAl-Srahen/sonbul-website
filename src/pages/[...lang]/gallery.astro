---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/pages/Gallery';
import { dict } from '../../i18n/dictionaries';
import { localePaths, langOf } from '../../i18n/paths';

export const getStaticPaths = localePaths;

const lang = langOf(Astro.params.lang as string | undefined);
const t = dict[lang];
---

<BaseLayout title={t.nav.gallery} description={t.gallery.hero.subtitle} path={Astro.url.pathname} lang={lang}>
  <Gallery lang={lang} client:load />
</BaseLayout>
