---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TeamMember from '../../../components/pages/TeamMember';
import { profiles, getProfile } from '../../../data/teamProfiles';
import { localeSlugPaths, langOf } from '../../../i18n/paths';
import { dict } from '../../../i18n/dictionaries';

export const getStaticPaths = () => localeSlugPaths(profiles.map((p) => p.slug));

const lang = langOf(Astro.params.lang as string | undefined);
const { slug } = Astro.params;
const profile = getProfile(slug!)!;
const description = lang === 'ar' && profile.arBio ? profile.arBio[0] : profile.bio[0];

const roles = dict[lang].team.roles as Record<string, string>;
const person = {
  name: profile.name,
  jobTitle: roles[profile.roleKey] ?? '',
  ...(profile.photo ? { image: new URL(profile.photo, Astro.site).href } : {}),
};
---

<BaseLayout
  title={profile.name}
  description={description}
  path={Astro.url.pathname}
  lang={lang}
  person={person}
  image={profile.photo}
>
  <TeamMember slug={slug!} lang={lang} client:load />
</BaseLayout>
