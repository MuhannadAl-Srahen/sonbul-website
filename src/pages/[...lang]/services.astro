---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Services from '../../components/pages/Services';
import { dict } from '../../i18n/dictionaries';
import { localePaths, langOf } from '../../i18n/paths';

export const getStaticPaths = localePaths;

const lang = langOf(Astro.params.lang as string | undefined);
const t = dict[lang];
---

<BaseLayout title={t.nav.services} description={t.services.hero.subtitle} path={Astro.url.pathname} lang={lang}>
  <Services lang={lang} />
</BaseLayout>
