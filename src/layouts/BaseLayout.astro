---
import Header from '../components/layout/Header';
import Footer from '../components/layout/Footer.astro';
import SEO from '../components/seo/SEO.astro';
import type { Lang } from '../i18n/types';
import { dict } from '../i18n/dictionaries';
import { companyFromPath } from '../data/companies';
import '../index.css';

interface Props {
  title: string;
  description: string;
  path: string;
  lang: Lang;
  image?: string;
  schema?: 'auto' | 'contact' | 'person' | 'none';
  person?: { name: string; jobTitle: string; image?: string };
  noindex?: boolean;
}

const { title, description, path, lang, image, schema, person, noindex } = Astro.props;

// The group hub uses the shared hero; every company page uses its own. Both are the
// largest paint on their page.
const isHome = path === '/' || path === '/ar/';
const preloadImage =
  companyFromPath(path)?.heroImage ?? (isHome ? '/assets/hero/hero.jpg' : undefined);

// Resolved once and shared with both the header and the structured data, so the visible
// navigation can never disagree with the page's schema about which company we are in.
const company = companyFromPath(path);
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/ficon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/ficon.png" />
    <link rel="apple-touch-icon" href="/ficon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#C8102E" />

    <SEO
      title={title}
      description={description}
      path={path}
      lang={lang}
      image={image}
      company={company}
      schema={schema}
      person={person}
      noindex={noindex}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Cairo:wght@300;400;600;700;800&display=swap"
      rel="stylesheet"
    />

    {/* Playfair Display used to be requested here. Nothing referenced it (`font-display`
        maps to Inter in tailwind.config.js), so it was a render-blocking request for a
        font that never rendered. */}

    {/* The LCP image on most pages. The preload scanner only finds it after parsing the
        page and both stylesheets, which is too late on a slow connection. */}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">{dict[lang].nav.skipToContent}</a>
    <Header currentPath={path} lang={lang} client:load />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    {/* Drives every [data-reveal] on the page. Lives here rather than inside the Reveal
        component so a failed island can never leave a section stranded at opacity 0. */}
    <script is:inline>
      (function () {
        // Inline styles rather than a class: React owns `className` and `data-*` on these
        // nodes and would drop a class we added on its next render, but it never removes
        // style properties that were not in its own style prop.
        var show = function (el) {
          el.style.opacity = '1';
          el.style.transform = 'none';
        };
        var all = function () {
          return document.querySelectorAll('[data-reveal]');
        };
        if (!('IntersectionObserver' in window)) {
          Array.prototype.forEach.call(all(), show);
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                show(e.target);
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '0px 0px -40px 0px' },
        );
        // Tracked so a rescan cannot re-observe something already revealed and
        // unobserved, which would restart its animation.
        var seen = new WeakSet();
        var scan = function () {
          Array.prototype.forEach.call(all(), function (el) {
            if (seen.has(el)) return;
            seen.add(el);
            io.observe(el);
          });
        };
        scan();

        // A page is one big island, and when an island fails to hydrate React recovers
        // by throwing away the server markup and rebuilding the subtree from scratch.
        // The replacements are not the nodes we observed, the originals were already
        // unobserved as they revealed, and the timeout below has long since fired, so
        // without this rescan every section stays at opacity 0 and the page reads as
        // blank. That has happened twice: once on /contact, once on the landing page.
        if ('MutationObserver' in window) {
          var queued = false;
          new MutationObserver(function () {
            if (queued) return;
            queued = true;
            requestAnimationFrame(function () {
              queued = false;
              scan();
            });
          }).observe(document.body, { childList: true, subtree: true });
        }

        // Safety net for an observer that never fires. Deliberately limited to what is
        // actually on screen: revealing everything would switch the scroll animation off
        // for the whole page after 1.5s, which is what an earlier version did.
        setTimeout(function () {
          Array.prototype.forEach.call(all(), function (el) {
            var r = el.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) show(el);
          });
        }, 1500);
      })();
    </script>
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </body>
</html>
