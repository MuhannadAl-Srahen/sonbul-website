<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Canonicalize to www" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^abusonbul-transporters\.com$" />
          </conditions>
          <action type="Redirect" url="https://www.abusonbul-transporters.com/{R:0}" redirectType="Permanent" />
        </rule>

        <!-- Legacy URLs from the previous site — still indexed by Google, redirect to the new routes -->
        <rule name="Legacy home" stopProcessing="true">
          <match url="^index(-2)?\.html$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy home ar" stopProcessing="true">
          <match url="^index(-2)?-ar\.html$" />
          <action type="Redirect" url="/ar/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy about" stopProcessing="true">
          <match url="^about\.html$" />
          <action type="Redirect" url="/about/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy about ar" stopProcessing="true">
          <match url="^about-ar\.html$" />
          <action type="Redirect" url="/ar/about/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy contact" stopProcessing="true">
          <match url="^contact\.html$" />
          <action type="Redirect" url="/contact/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy contact ar" stopProcessing="true">
          <match url="^contact-ar\.html$" />
          <action type="Redirect" url="/ar/contact/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy services" stopProcessing="true">
          <match url="^service\.html$" />
          <action type="Redirect" url="/services/" redirectType="Permanent" />
        </rule>
        <rule name="Legacy services ar" stopProcessing="true">
          <match url="^service-ar\.html$" />
          <action type="Redirect" url="/ar/services/" redirectType="Permanent" />
        </rule>

        <!-- /ar exists, so people and bots guess at /en too -->
        <rule name="Locale en root" stopProcessing="true">
          <match url="^en/?$" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Locale en paths" stopProcessing="true">
          <match url="^en/(.*)$" />
          <action type="Redirect" url="/{R:1}/" redirectType="Permanent" />
        </rule>

        <!-- Short aliases for print material and QR codes. Keep in step with vercel.json and .htaccess. -->
        <rule name="Alias transportation" stopProcessing="true">
          <match url="^(ar/)?transportation/?$" />
          <action type="Redirect" url="/{R:1}transport/" redirectType="Permanent" />
        </rule>
        <rule name="Alias fleet" stopProcessing="true">
          <match url="^(ar/)?fleet/?$" />
          <action type="Redirect" url="/{R:1}transport/fleet/" redirectType="Permanent" />
        </rule>
        <rule name="Alias routes" stopProcessing="true">
          <match url="^(ar/)?routes/?$" />
          <action type="Redirect" url="/{R:1}transport/routes/" redirectType="Permanent" />
        </rule>
        <rule name="Alias cargo" stopProcessing="true">
          <match url="^(ar/)?cargo/?$" />
          <action type="Redirect" url="/{R:1}transport/cargo/" redirectType="Permanent" />
        </rule>
        <rule name="Alias projects" stopProcessing="true">
          <match url="^(ar/)?projects/?$" />
          <action type="Redirect" url="/{R:1}project-services/projects/" redirectType="Permanent" />
        </rule>
        <rule name="Alias camps" stopProcessing="true">
          <match url="^(ar/)?camps/?$" />
          <action type="Redirect" url="/{R:1}project-services/camps/" redirectType="Permanent" />
        </rule>
        <rule name="Alias catering" stopProcessing="true">
          <match url="^(ar/)?catering/?$" />
          <action type="Redirect" url="/{R:1}project-services/catering/" redirectType="Permanent" />
        </rule>
        <rule name="Alias crossings" stopProcessing="true">
          <match url="^(ar/)?(borders|crossings)/?$" />
          <action type="Redirect" url="/{R:1}logistics/crossings/" redirectType="Permanent" />
        </rule>
        <rule name="Alias customs" stopProcessing="true">
          <match url="^(ar/)?customs/?$" />
          <action type="Redirect" url="/{R:1}logistics/customs/" redirectType="Permanent" />
        </rule>
        <!-- Ambiguous between two companies, so it lands on the group index that lists both. -->
        <rule name="Alias equipment" stopProcessing="true">
          <match url="^(ar/)?equipment/?$" />
          <action type="Redirect" url="/{R:1}services/" redirectType="Permanent" />
        </rule>

      </rules>
    </rewrite>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="File" />
    </httpErrors>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
