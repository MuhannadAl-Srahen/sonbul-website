    { "source": "/ar/borders", "destination": "/ar/logistics/crossings", "permanent": true },
    { "source": "/ar/crossings", "destination": "/ar/logistics/crossings", "permanent": true },
    { "source": "/ar/customs", "destination": "/ar/logistics/customs", "permanent": true },
    { "source": "/ar/equipment", "destination": "/ar/services", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
