{
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/index-2.html", "destination": "/", "permanent": true },
    { "source": "/index-ar.html", "destination": "/ar", "permanent": true },
    { "source": "/index-2-ar.html", "destination": "/ar", "permanent": true },
