    { "source": "/service.html", "destination": "/services", "permanent": true },
    { "source": "/service-ar.html", "destination": "/ar/services", "permanent": true },

    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/:path*", "destination": "/:path*", "permanent": true },

    { "source": "/transportation", "destination": "/transport", "permanent": true },
    { "source": "/fleet", "destination": "/transport/fleet", "permanent": true },
    { "source": "/routes", "destination": "/transport/routes", "permanent": true },
