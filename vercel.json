    { "source": "/camps", "destination": "/project-services/camps", "permanent": true },
    { "source": "/catering", "destination": "/project-services/catering", "permanent": true },
    { "source": "/borders", "destination": "/logistics/crossings", "permanent": true },
    { "source": "/crossings", "destination": "/logistics/crossings", "permanent": true },
    { "source": "/customs", "destination": "/logistics/customs", "permanent": true },
    { "source": "/equipment", "destination": "/services", "permanent": true },

    { "source": "/ar/transportation", "destination": "/ar/transport", "permanent": true },
    { "source": "/ar/fleet", "destination": "/ar/transport/fleet", "permanent": true },
    { "source": "/ar/routes", "destination": "/ar/transport/routes", "permanent": true },
    { "source": "/ar/cargo", "destination": "/ar/transport/cargo", "permanent": true },
    { "source": "/ar/projects", "destination": "/ar/project-services/projects", "permanent": true },
    { "source": "/ar/camps", "destination": "/ar/project-services/camps", "permanent": true },
