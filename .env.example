# Copy to .env for local development. On the host, set these as environment variables.
# The build fails without them rather than shipping a contact form that silently fails.
#
# From the EmailJS dashboard: Email Services, Email Templates, and Account > API Keys.
# All three are PUBLIC_ by design — EmailJS public keys are meant to reach the browser.

PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=
